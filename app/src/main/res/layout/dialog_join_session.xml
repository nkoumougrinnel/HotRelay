<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/join_host_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/join_host_instruction"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Label 1: Adresse IP de l'hôte -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/host_ip_label"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etHostIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="none"
        android:background="@drawable/bg_badge_gray"
        android:digits="0123456789."
        android:hint="192.168.43.1"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Assuré 192.168.43.1 sur un hotspot Android"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <!-- Label 2: Port -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/port_label"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="none"
        android:background="@drawable/bg_badge_gray"
        android:hint="5000"
        android:inputType="number"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <!-- Label 3: Votre nom -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/your_name_label"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="name"
        android:background="@drawable/bg_badge_gray"
        android:hint="Paul"
        android:inputType="textPersonName"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Visible par les autres appareils."
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Info Note Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_host_orange"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="💡 Pas de connexion ? Vérifiez que votre Wi-Fi est bien connecté au hotspot de l'hôte, pas à un autre réseau."
            android:textColor="@color/primary"
            android:textSize="12sp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <!-- Solid Orange Button: Se connecter -->
    <LinearLayout
        android:id="@+id/btnConfirmJoin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_orange"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>